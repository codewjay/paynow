# Copy this file to .env and fill in real values.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/paynow?retryWrites=true&w=majority

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=replace_with_strong_random_string
JWT_EXPIRES_IN=30d

# Firebase Admin SDK service account (Project Settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the entire private key on one line; keep the literal \n sequences — the code converts them back to real newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Comma-separated allowed origins for CORS (Expo dev URL, deployed web URL, etc.)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081,exp://*
